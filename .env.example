# =============================================================================
# Kenya Cup Fantasy Rugby – Environment Configuration Template
# =============================================================================
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# IMPORTANT:
# - NEVER commit .env.local or production secrets to Git.
# - Variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# - Server-side secrets (SUPABASE_SERVICE_ROLE_KEY, CLOUDINARY_API_SECRET,
#   ADMIN_SECRET_KEY) must remain confidential.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Application Configuration
# -----------------------------------------------------------------------------
# Canonical URL of your deployment (used for metadata, open graph, and auth redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Current active tournament season and gameweek number
NEXT_PUBLIC_SEASON=26/27
NEXT_PUBLIC_CURRENT_GAMEWEEK=4

# -----------------------------------------------------------------------------
# 2. Supabase (Database, Auth & Realtime)
# -----------------------------------------------------------------------------
# Dashboard: https://supabase.com/dashboard -> Project Settings -> API
# Public Project URL:
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Public anonymous key (safe for client-side queries with Row Level Security)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key

# Service role key (privileged server-side operations, bypasses RLS - KEEP SECRET)
SUPABASE_SERVICE_ROLE_KEY=your-super-secret-service-role-key

# -----------------------------------------------------------------------------
# 3. Cloudinary Media Storage (Player Headshots & Club Crests)
# -----------------------------------------------------------------------------
# Dashboard: https://console.cloudinary.com/settings/api-keys
# Cloud Name (publicly accessible identifier for image delivery & upload widget)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name

# Cloudinary API Key (used for client widget and signed asset operations)
NEXT_PUBLIC_CLOUDINARY_API_KEY=your-api-key

# Cloudinary API Secret (server-side administrative operations only - KEEP SECRET)
CLOUDINARY_API_SECRET=your-api-secret

# Cloudinary Unsigned Upload Preset (configured in Cloudinary console -> Settings -> Upload)
# Recommended preset name: kc_players (with auto-format / f_avif,q_auto transforms)
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=kc_players

# -----------------------------------------------------------------------------
# 4. Security & Admin Access
# -----------------------------------------------------------------------------
# Secret passphrase / key for administrative endpoints and webhook verification
ADMIN_SECRET_KEY=your-secure-admin-passphrase-change-in-production
