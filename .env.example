# =============================================================================
# Kenya Cup Fantasy Rugby – Production Environment Configuration Template
# =============================================================================
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# IMPORTANT:
# - NEVER commit .env.local or production secrets to Git.
# - Variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# - Server-side secrets (SUPABASE_SERVICE_ROLE_KEY, CLOUDINARY_API_SECRET,
#   ADMIN_SECRET_KEY) must remain confidential in Vercel / hosting provider.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Application Configuration
# -----------------------------------------------------------------------------
# Canonical URL of your deployment (e.g. https://kenyacupfantasy.co.ke)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Current active tournament season and active gameweek number
NEXT_PUBLIC_SEASON=26/27
NEXT_PUBLIC_CURRENT_GAMEWEEK=1

# -----------------------------------------------------------------------------
# 2. Supabase (Database, Auth, Connection Pooling & PgBouncer/Supavisor)
# -----------------------------------------------------------------------------
# Dashboard: https://supabase.com/dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Production Connection Pooling (Supavisor/PgBouncer port 6543) to prevent
# database connection exhaustion during high-concurrency 30-min kickoff spikes:
NEXT_PUBLIC_SUPABASE_POOLED_URL=https://your-project-id.supabase.co

# Public anonymous key (safe for client-side queries with Row Level Security)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key

# Service role key (privileged server-side operations, bypasses RLS - KEEP SECRET)
SUPABASE_SERVICE_ROLE_KEY=your-super-secret-service-role-key

# -----------------------------------------------------------------------------
# 3. Cloudinary Media Storage (Player Headshots, Club Crests, Avatars)
# -----------------------------------------------------------------------------
# Dashboard: https://console.cloudinary.com/settings/api-keys
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
NEXT_PUBLIC_CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Cloudinary Unsigned Upload Preset (Settings -> Upload -> Upload Presets -> Add preset)
# Set Folder to kenya-cup/players or kenya-cup/avatars, Signing mode: Unsigned
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=kc_players

# Official Tournament & Federation Logos
NEXT_PUBLIC_KENYA_CUP_LOGO_URL=https://res.cloudinary.com/your-cloud-name/image/upload/v1794257649/rgvpgycuvay5zrc0faew.png
NEXT_PUBLIC_KRU_LOGO_URL=https://res.cloudinary.com/your-cloud-name/image/upload/v1794257672/jr5ge1rnkiusgsozyrqy.png

# -----------------------------------------------------------------------------
# 4. Security & Admin Access (Edge Middleware Verification)
# -----------------------------------------------------------------------------
# Cryptographic secret key used to sign and verify Edge Middleware admin tokens
ADMIN_SECRET_KEY=your-ultra-secure-random-secret-key-for-admin-middleware

# Designated primary admin email address
ADMIN_EMAIL=admin@kenyacupfantasy.co.ke
